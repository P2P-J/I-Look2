{
  "manifest_version": 3,
  "name": "I Look",
  "version": "0.1.0",
  "description": "ChatGPT·Claude 화면을 내 색으로. 추천 테마를 고르거나 색 2~3개만 정하면 글자 대비까지 자동으로 맞춰 줍니다.",
  "default_locale": "ko",
  "permissions": ["storage", "scripting", "webNavigation"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "https://*.claudeusercontent.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "I Look"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["adapters/chatgpt.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["adapters/claude.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://*.claudeusercontent.com/*"],
      "js": ["content.js"],
      "css": ["adapters/claude.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
